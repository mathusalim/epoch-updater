{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Electron: Main",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run-script", "start"],
      "windows": {
        "runtimeExecutable": "npm.cmd"
      },
      "env": {
        "ELECTRON_ENABLE_LOGGING": "true"
      },
      "console": "integratedTerminal",
      "outputCapture": "std",
      "protocol": "inspector"
    }
  ]
}
